FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

WORKDIR /app
# Editable install adds .../src to sys.path; repo imports also need parent dir for `from src import ...`.
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    CONDA_DIR=/opt/conda \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Miniconda (for rdkit + graph-tool)
RUN curl -fsSL -o /tmp/miniconda.sh \
    https://repo.anaconda.com/miniconda/Miniconda3-py310_24.1.2-0-Linux-x86_64.sh \
    && bash /tmp/miniconda.sh -b -p "$CONDA_DIR" \
    && rm -f /tmp/miniconda.sh

ENV PATH="$CONDA_DIR/bin:$PATH"

RUN conda config --system --set channel_priority strict \
    && conda install -y -c conda-forge \
    python=3.10 \
    rdkit=2023.03.2 \
    graph-tool=2.45 \
    && conda clean -afy

# Match ogad-vanilla-digress2.ipynb runtime (Kaggle/local): Hydra, OpenMP, allocator, W&B off.
# If you use W&B, do not bake keys into the image: `docker run -e WANDB_API_KEY=...` or compose `environment:`.
ENV WANDB_DISABLED=true \
    HYDRA_FULL_ERROR=1 \
    LD_PRELOAD=/opt/conda/lib/libgomp.so.1 \
    LD_LIBRARY_PATH=/opt/conda/lib:${LD_LIBRARY_PATH} \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64,expandable_segments:True

COPY requirements.txt ./

# Torch + CUDA 11.8 wheels (match DiGress tested stack)
RUN python -m pip install --no-cache-dir -U pip \
    && python -m pip install --no-cache-dir \
    torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 \
    --index-url https://download.pytorch.org/whl/cu118

# PyG wheels for torch 2.0.1 + cu118, then torch-geometric (pinned in requirements.txt)
RUN python -m pip install --no-cache-dir \
    torch-scatter torch-sparse torch-cluster torch-spline-conv \
    -f https://data.pyg.org/whl/torch-2.0.1+cu118.html \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY . .

# Install project in editable mode (deps already from requirements.txt); compile ORCA binary
RUN python -m pip install --no-cache-dir --no-deps -e . \
    && g++ -O2 -std=c++11 -o src/analysis/orca/orca src/analysis/orca/orca.cpp

CMD ["python", "src/main.py", "+experiment=community_graphs", "train.batch_size=32"]